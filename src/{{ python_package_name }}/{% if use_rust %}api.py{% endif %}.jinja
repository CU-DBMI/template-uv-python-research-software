from __future__ import annotations


def sum_primes(limit: int) -> int:
    """
    Sum the prime numbers strictly less than ``limit``.

    Args:
        limit (int):
            Exclusive upper bound. Must be non-negative.

    Returns:
        int:
            The sum of every prime ``p`` with ``p < limit``.
    """

    from {{ python_package_name }} import _native

    return _native.sum_primes(limit)


def count_primes(limit: int) -> int:
    """
    Count the prime numbers strictly less than ``limit``.

    Args:
        limit (int):
            Exclusive upper bound. Must be non-negative.

    Returns:
        int:
            The number of primes ``p`` with ``p < limit``.
    """

    from {{ python_package_name }} import _native

    return _native.count_primes(limit)
