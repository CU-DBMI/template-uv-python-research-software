---
# used for publishing packages to pypi on release
name: publish pypi release
{% if use_rust %}
on:
  release:
    types:
      - published

permissions:
  contents: read

jobs:
  # Build one abi3 wheel per platform. Because the extension is built against
  # CPython's stable ABI (abi3-py311), a single wheel per platform serves every
  # supported Python version, so there is no per-interpreter build matrix.
  build_wheels:
    name: wheel ({{ '${{ matrix.target }}' }} on {{ '${{ matrix.runner }}' }})
    runs-on: {{ '${{ matrix.runner }}' }}
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: ubuntu-24.04
            target: x86_64
          - runner: ubuntu-24.04-arm
            target: aarch64
          - runner: macos-14
            target: aarch64
          - runner: macos-13
            target: x86_64
          - runner: windows-2022
            target: x64
    steps:
      - name: Checkout
        uses: actions/checkout@v7.0.1
        with:
          persist-credentials: false
      - name: Python setup
        uses: actions/setup-python@v7
        with:
          python-version: "3.11"
      - name: Rust setup
        uses: dtolnay/rust-toolchain@stable
      - name: Sync package version from release tag
        env:
          RELEASE_TAG: {{ '${{ github.event.release.tag_name }}' }}
        shell: bash
        run: python tools/sync_release_version.py "$RELEASE_TAG"
      - name: Build wheel
        uses: PyO3/maturin-action@v1.51.0
        with:
          target: {{ '${{ matrix.target }}' }}
          args: --release --out dist
          manylinux: auto
      - name: Upload wheel
        uses: actions/upload-artifact@v7.0.1
        with:
          name: wheels-{{ '${{ matrix.runner }}' }}-{{ '${{ matrix.target }}' }}
          path: dist/*.whl
          if-no-files-found: error

  build_sdist:
    name: source distribution
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v7.0.1
        with:
          persist-credentials: false
      - name: Python setup
        uses: actions/setup-python@v7
        with:
          python-version: "3.11"
      - name: Rust setup
        uses: dtolnay/rust-toolchain@stable
      - name: Sync package version from release tag
        env:
          RELEASE_TAG: {{ '${{ github.event.release.tag_name }}' }}
        shell: bash
        run: python tools/sync_release_version.py "$RELEASE_TAG"
      - name: Build source distribution
        uses: PyO3/maturin-action@v1.51.0
        with:
          command: sdist
          args: --out dist
      - name: Upload source distribution
        uses: actions/upload-artifact@v7.0.1
        with:
          name: sdist
          path: dist/*.tar.gz
          if-no-files-found: error

  publish_pypi:
    name: publish to PyPI
    needs:
      - build_wheels
      - build_sdist
    runs-on: ubuntu-24.04
    environment: release
    permissions:
      # IMPORTANT: this permission is mandatory for trusted publishing
      id-token: write
    steps:
      - name: Download package distributions
        uses: actions/download-artifact@v8.0.1
        with:
          path: dist
          pattern: "*"
          merge-multiple: true
      - name: Publish package distributions to PyPI
        uses: pypa/gh-action-pypi-publish@v1.14.2
{% else %}

on:
  release:
    types:
      - published

jobs:
  publish_pypi:
    runs-on: ubuntu-latest
    environment: release
    permissions:
      contents: read
      # IMPORTANT: this permission is mandatory for trusted publishing
      id-token: write
    steps:
      - name: Checkout
        uses: actions/checkout@v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Fetch tags
        run: git fetch --all --tags
      - name: Python setup
        uses: actions/setup-python@v7
        with:
          python-version: "3.11"
      - name: Install the latest version of uv
        uses: astral-sh/setup-uv@v10.0.1
        with:
          enable-cache: false
      - name: uv build distribution content
        run: uv build
      - name: Publish package distributions to PyPI
        uses: pypa/gh-action-pypi-publish@v1.14.2
{% endif %}
